@model List<Application.DTOs.OrderAssignmentDTO>
@{
    ViewData["Title"] = "Assign Orders";
    Layout = "_ManagerLayout";
}

<div class="container-fluid mt-4">

    <!-- Heading -->
    <div class="mb-4">
        <h2 class="heading-hover text-white p-3 rounded" >
            <i class="bi bi-person-gear me-2"></i> Assign Orders to Workers
        </h2>
    </div>

    <!-- Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-custom text-white">
                        <tr>
                            <th scope="col">Order ID</th>
                            <th scope="col">Customer</th>
                            <th scope="col">Garment Type</th>
                            <th scope="col">Quantity</th>
                            <th scope="col">Status</th>
                            <th scope="col">Delivery Date</th>
                            <th scope="col">Instructions</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>#@order.OrderId</td>
                                <td>@order.CustomerName</td>
                                <td>@order.GarmentType</td>
                                <td>@order.Quantity</td>
                                <td>
                                    <span class="badge 
                                        @(order.Status == "Completed" ? "bg-success" :
                                          order.Status == "InProgress" ? "bg-info text-dark" :
                                          order.Status == "Pending" ? "bg-warning text-dark" : "bg-secondary")">
                                        @order.Status
                                    </span>
                                </td>
                                <td>@order.DeliveryDate.ToString("dd MMM yyyy")</td>
                                <td>@(string.IsNullOrEmpty(order.CustomerInstructions) ? "No instructions" : order.CustomerInstructions)</td>
                                <td>
                                    <a asp-action="AssignOrder" asp-route-orderId="@order.OrderId" 
                                       class="btn btn-sm btn-outline-custom">
                                       <i class="bi bi-pencil-square me-1"></i> Assign/Edit
                                    </a>
                                    
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
.heading-hover {
    background: #B13BFF;
    transition: background 0.3s ease;
}

.heading-hover:hover {
    color: #FA812F; /* orange on hover */
    cursor: pointer; /* optional, shows it's interactive */
}
    .table-hover tbody tr:hover {
        background-color: rgba(67, 97, 238, 0.1);
        transition: background 0.3s ease;
    }

    .badge {
        font-size: 0.85rem;
        padding: 0.45em 0.65em;
        border-radius: 0.5rem;
    }

    a.btn-outline-custom{
        background-color:#B13BFF;
        color:white;
        transition: all 0.3s ease;
    }

    a.btn-outline-primary:hover {
        background-color: #4361ee;
        color: white;
    }
   .table-custom  {
    background-color:  #456882;
    color: #fff;
}
.table-custom :hover {

    color: orange;
}
    @@media (max-width: 768px) {
        .table-responsive {
            overflow-x: auto;
        }
        table th, table td {
            font-size: 0.9rem;
            padding: 0.5rem;
        }
    }
</style>
