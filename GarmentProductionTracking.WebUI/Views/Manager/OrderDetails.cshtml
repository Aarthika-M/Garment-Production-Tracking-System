@model Application.DTOs.OrderAssignmentDTO
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = $"Order Details #{Model.OrderId}";

    // Enhanced Status Logic
    string statusBadgeClass = Model.Status switch
    {
        "Completed" => "bg-success",
        "Shipped" => "bg-info text-dark",
        "InProgress" => "bg-primary",
        _ => "bg-warning text-dark"
    };
    string statusIcon = Model.Status == "Completed" ? "bi-check-circle-fill" : "bi-gear-fill";
}

<div class="container fluid mt-4">

    <!-- Header -->
    <div class="order-header d-flex justify-content-between align-items-center mb-4 border-bottom pb-2 p-3 rounded-3">
        <h2 class="display-6 fw-bold mb-0">
            <i class="bi bi-file-earmark-text-fill me-2"></i>Order Details
        </h2>
        <a asp-action="Dashboard" class="btn btn-outline-light rounded-pill fw-semibold order-back-btn">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="row">

        <!-- Order Specifications -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-lg border-0 rounded-4 h-100">
                <div class="card-header bg-light-subtle rounded-top-4 py-3">
                    <h5 class="mb-0 fw-bold text-dark-emphasis">
                        <i class="bi bi-info-square me-2"></i>Order Specifications #@Model.OrderId
                    </h5>
                </div>
                <div class="card-body p-4">
                    <dl class="row detail-list">
                        <dt class="col-sm-4 text-muted">Customer:</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.CustomerName</dd>
                        
                        <dt class="col-sm-4 text-muted">Garment Type:</dt>
                        <dd class="col-sm-8">@Model.GarmentType</dd>
                        
                        <dt class="col-sm-4 text-muted">Quantity:</dt>
                        <dd class="col-sm-8 fw-bold text-info">@Model.Quantity Units</dd>

                         <dt class="col-sm-4 text-muted">Instruction:</dt>
                        <dd class="col-sm-8">@Model.CustomerInstructions</dd>
                        
                        <dt class="col-sm-4 text-muted">Worker:</dt>
                        <dd class="col-sm-8 fw-bold">@Html.Raw(Model.WorkerName ?? "<span class='text-danger'>Not Assigned</span>")</dd>
                    </dl>
                    
                    <hr>

                    <dl class="row detail-list">
                        <dt class="col-sm-4 text-muted">Order Date:</dt>
                        <dd class="col-sm-8">@Model.OrderDate.ToString("dd MMM yyyy")</dd>
                        
                        <dt class="col-sm-4 text-muted">Delivery Deadline:</dt>
                        @{
                            string deliveryClass = (Model.DeliveryDate < DateTime.Today.AddDays(7) && Model.Status != "Completed") ? "text-danger fw-bold" : "";
                        }
                        <dd class="col-sm-8 @deliveryClass">@Model.DeliveryDate.ToString("dd MMM yyyy")</dd>

                        <dt class="col-sm-4 text-muted">Current Status:</dt>
                        <dd class="col-sm-8">
                            <span class="badge rounded-pill @statusBadgeClass status-badge-lg">
                                <i class="bi @statusIcon me-1"></i> @Model.Status
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Design & Progress -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-lg border-0 rounded-4 h-100">
                <div class="card-header bg-light-subtle rounded-top-4 py-3">
                    <h5 class="mb-0 fw-bold text-dark-emphasis">
                        <i class="bi bi-palette-fill me-2"></i>Design & Progress
                    </h5>
                </div>
                <div class="card-body p-4 text-center">
                    
                    <div class="mb-4 p-3 bg-light rounded-3 image-box">
                        @if (Model.ImageContent != null && Model.ImageContent.Length > 0)
                        {
                            var base64 = Convert.ToBase64String(Model.ImageContent);
                            <img src="data:image/png;base64,@base64"
                                 class="img-fluid rounded-3 border"
                                 alt="Design Image" />
                        }
                        else
                        {
                            <div class="text-muted p-4">
                                <i class="bi bi-image-fill fs-1 d-block mb-2"></i>
                                <div>No Design Image Available</div>
                            </div>
                        }
                    </div>
                    
                    <div class="text-start">
                        <h6 class="fw-bold mb-3 text-dark-emphasis">Production Timeline:</h6>
                        <ul class="timeline">
                            <li class="@(Model.Status == "Pending" ? "active" : "complete")">Order Received</li>
                            <li class="@(Model.Status == "InProgress" || Model.Status == "Completed" ? "active" : "")">Production Started</li>
                            <li class="@(Model.Status == "Completed" ? "complete" : "")">Quality Check & Finish</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    /* Header */
    .order-header {
        background-color: #B13BFF; /* Purple background */
        color: white;
    }
    .order-header h2 {
        color: white;
    }
    .order-header h2:hover{
        color:orange;
    }
    .order-back-btn {
        background-color: #450693; 
        color: white;
        border-color: white;
        transition: all 0.3s ease;
    }
    .order-back-btn:hover {
        background-color: #9929EA;      /* Orange hover */
        border-color: white;
        color:#FA812F;
    }

    /* Card Styling */
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .card-header {
        border-bottom: 1px solid #dee2e6;
    }
    .detail-list {
        font-size: 1rem;
    }
    .text-muted {
        color: #6c757d !important;
    }

    /* Timeline */
    .timeline {
        list-style-type: none;
        padding-left: 1rem;
    }
    .timeline li {
        position: relative;
        padding-bottom: 1.5rem;
        border-left: 2px solid #ccc;
        margin-left: 10px;
        color: #adb5bd;
    }
    .timeline li:last-child {
        border-left: none;
        padding-bottom: 0;
    }
    .timeline li:before {
        content: '';
        position: absolute;
        top: 0;
        left: -11px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background-color: #fff;
        border: 2px solid #ccc;
    }
    .timeline li.complete {
        color: #28a745;
    }
    .timeline li.complete:before {
        background-color: #28a745;
        border-color: #28a745;
    }
    .timeline li.active {
        color: #0d6efd;
        font-weight: 600;
    }
    .timeline li.active:before {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

    /* Image */
    .image-box img {
        max-height: 250px; 
        max-width: 100%;
        object-fit: contain;
        background-color: white;
    }

    /* Status badge */
    .status-badge-lg {
        font-size: 0.9rem;
        padding: 0.5em 1em;
        font-weight: 600;
    }
</style>
