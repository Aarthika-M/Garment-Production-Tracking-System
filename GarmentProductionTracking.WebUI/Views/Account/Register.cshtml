@model Application.DTOs.UserRegisterDTO
@{
    ViewData["HideSidebar"] = true;
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Register</title>
   

    <style>
        body {
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Jost', sans-serif;
            background: linear-gradient(to bottom, #170c29, #452b63, #2f243e);
        }

        .main {
            width: 450px;
            height: 520px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            box-shadow: 5px 20px 50px #000;
            overflow: hidden;
            backdrop-filter: blur(8px);
        }

        .register {
            position: relative;
            width: 100%;
            height: 100%;
            padding-top: 40px;
        }

        .register label {
            color: #fff;
            font-size: 2em;
            text-align: center;
            display: block;
            font-weight: bold;
            margin-bottom: 70px;
        }

        .register input,
        .register select {
            width: 70%;
            height: 40px;
            background: #e0dede;
            display: block;
            margin: 15px auto;
            padding: 10px;
            border: none;
            outline: none;
            border-radius: 5px;
        }

        .password-container {
            position: relative;
            width: 70%;
            margin: 15px auto;
        }

        .password-container input {
            width: 100%;
            height: 40px;
            padding-right: 35px;
            border-radius: 5px;
            border: none;
            outline: none;
            background: #e0dede;
            padding: 10px 40px 10px 10px;
        }

         .password-container i {
            position: absolute;
            right: 12px;
            top: 8px;
            cursor: pointer;
            color: #573b8a;
            font-size: 1.2em;
        }
        .register button {
            width: 70%;
            height: 40px;
            margin: 25px auto;
            display: block;
            color: #fff;
            background: #573b8a;
            font-size: 1em;
            font-weight: bold;
            border: none;
            border-radius: 5px;
            transition: .3s ease;
            cursor: pointer;
        }

        .register button:hover {
            background: #6d44b8;
        }

        .register p {
            text-align: center;
            color: #fff;
        }

        .register a {
            color: #FA812F;
            text-decoration: none;
            font-weight: 600;
        }

        .register a:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>
    <div class="main">
        <div class="register">
            <form asp-action="Register" method="post">
                <label>Register</label>

                <input asp-for="Username" placeholder="Username" required />
                <span asp-validation-for="Username" class="text-danger small d-block text-center"></span>

                <div class="password-container">
                    <input asp-for="Password" type="password" placeholder="Password" id="registerPassword" required />
                    <i class="bi bi-eye-slash" id="toggleRegisterPassword"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger small d-block text-center"></span>

                <select asp-for="Role" required>
                    <option value="">Select Role</option>
                    <option>Manager</option>
                    <option>Worker</option>
                    <option>Customer</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small d-block text-center"></span>

                <button type="submit">
                    <i class="bi bi-person-plus-fill me-2"></i> Register
                </button>

                <p>Already have an account?
                    <a asp-controller="Account" asp-action="Login">Login here</a>
                </p>
            </form>
        </div>
    </div>

    <script>
        const togglePassword = document.getElementById("toggleRegisterPassword");
        const passwordField = document.getElementById("registerPassword");

        togglePassword.addEventListener("click", function () {
            const type = passwordField.getAttribute("type") === "password" ? "text" : "password";
            passwordField.setAttribute("type", type);
            this.classList.toggle("bi-eye");
            this.classList.toggle("bi-eye-slash");

            // ️ Hide text again after 1 second
            if (type === "text") {
                setTimeout(() => {
                    passwordField.setAttribute("type", "password");
                    this.classList.add("bi-eye-slash");
                    this.classList.remove("bi-eye");
                }, 1000);
            }
        });
    </script>
</body>
</html>
