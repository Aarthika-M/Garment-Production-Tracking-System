@model Application.DTOs.UserLoginDTO
@{
    ViewData["HideSidebar"] = true;
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login</title>
    

    <style>
        body {
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Jost', sans-serif;
            background: linear-gradient(to bottom, #170c29, #452b63, #2f243e);
        }

        .main {
            width: 450px;
            height: 480px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            box-shadow: 5px 20px 50px #000;
            overflow: hidden;
            backdrop-filter: blur(8px);
        }

        .login {
            position: relative;
            width: 100%;
            height: 100%;
            padding-top: 30px;
        }

        .login label {
            color: #fff;
            font-size: 2em;
            text-align: center;
            display: block;
            font-weight: bold;
            margin-bottom: 80px;
        }

        .login input {
            width: 70%;
            height: 40px;
            background: #e0dede;
            display: block;
            margin: 20px auto;
            padding: 10px;
            border: none;
            outline: none;
            border-radius: 5px;
        }

        /* Password field container for icon */
         .password-container {
            position: relative;
            width: 70%;
            margin: 15px auto;
        }

        .password-container input {
            width: 100%;
            height: 40px;
            padding-right: 35px;
            border-radius: 5px;
            border: none;
            outline: none;
            background: #e0dede;
            padding: 10px 40px 10px 10px;
        }

         .password-container i {
            position: absolute;
            right: 12px;
            top: 8px;
            cursor: pointer;
            color: #573b8a;
            font-size: 1.2em;
        }

        .login button {
            width: 70%;
            height: 40px;
            margin: 25px auto;
            display: block;
            color: #fff;
            background: #573b8a;
            font-size: 1em;
            font-weight: bold;
            border: none;
            border-radius: 5px;
            transition: .3s ease;
            cursor: pointer;
        }

        .login button:hover {
            background: #6d44b8;
        }

        .login p {
            text-align: center;
            color: #fff;
        }

        .login a {
            color: #FA812F;
            text-decoration: none;
            font-weight: 600;
        }

        .login a:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>
    <div class="main">
        <div class="login">
            <form asp-action="Login" method="post">
                <label>Login</label>

                <!-- Username -->
                <input asp-for="Username" placeholder="Username" required />
                <span asp-validation-for="Username" class="text-danger small d-block text-center"></span>

                <!-- Password with Eye Icon -->
               <div class="password-container">
                    <input asp-for="Password" type="password" placeholder="Password" id="loginPassword" required />
                    <i class="bi bi-eye-slash" id="toggleLoginPassword"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger small d-block text-center"></span>


                <!-- Submit -->
                <button type="submit">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Login
                </button>

                <!-- Register Redirect -->
                <p>Don’t have an account?
                    <a asp-controller="Account" asp-action="Register">Register here</a>
                </p>
            </form>
        </div>
    </div>

     <script>
        const togglePassword = document.getElementById("toggleLoginPassword");
        const passwordField = document.getElementById("loginPassword");

        togglePassword.addEventListener("click", function () {
            const type = passwordField.getAttribute("type") === "password" ? "text" : "password";
            passwordField.setAttribute("type", type);
            this.classList.toggle("bi-eye");
            this.classList.toggle("bi-eye-slash");

            // ️ Hide text again after 1 second
            if (type === "text") {
                setTimeout(() => {
                    passwordField.setAttribute("type", "password");
                    this.classList.add("bi-eye-slash");
                    this.classList.remove("bi-eye");
                }, 1000);
            }
        });
    </script>
</body>
</html>

