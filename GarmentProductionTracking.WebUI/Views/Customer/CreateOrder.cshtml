@model Application.DTOs.CustomerOrderDTO
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Create New Garment Order";
}

<style>
    
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f4f4f9;
    }

    .order-container {
        display: flex;
        justify-content: center;
        align-items: flex-start; /* top align */
        padding: 1.5rem 1rem 3rem 0; /* leave space for sidebar */
        min-height: 100vh;
        
        width: 100%;
        box-sizing: border-box;
    }

    .order-card {
        width: 100%;
        max-width: 900px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .order-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
    }

    .order-header {
        background: #B13BFF;
        color: white;
        padding: 1.5rem 2rem;
        border-radius: 16px 16px 0 0;
    }

    .order-header h1 {
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 0.3rem;
    }
    .order-header:hover{
        color:#FA812F;
    }

    .order-header p {
        opacity: 0.85;
        margin-bottom: 0;
    }

    .order-body {
        padding: 1.5rem 2rem;
    }

    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 0.4rem;
    }

    .form-control {
        border-radius: 10px;
        border: 1.5px solid #ddd;
        padding: 0.65rem 1rem;
        transition: all 0.2s ease;
    }

    .form-control:focus {
        border-color: #6a11cb;
        box-shadow: 0 0 0 3px rgba(106, 17, 203, 0.15);
    }

    textarea.form-control {
        resize: none;
    }

    .btn-submit {
        background:#B13BFF;
        border: none;
        border-radius: 10px;
        padding: 0.9rem 2rem;
        font-weight: 600;
        font-size: 1rem;
        color: white;
        transition: all 0.3s ease;
        width: 100%;
    }

    .btn-submit:hover {
        background: #9929EA;
        box-shadow: 0 8px 20px rgba(106, 17, 203, 0.25);
        transform: translateY(-2px);
        color:#FA812F;
    }

    .section-title {
        font-weight: 600;
        color: #444;
        margin-bottom: 1rem;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .section-title i {
        color: #6a11cb;
    }

    .file-upload-area {
        border: 2px dashed #ccc;
        border-radius: 10px;
        text-align: center;
        padding: 1.5rem;
        transition: all 0.3s ease;
        background-color: #fafafa;
    }

    .file-upload-area:hover {
        border-color: #6a11cb;
        background: #f3e8ff;
    }

    .upload-icon {
        font-size: 2rem;
        color: #6a11cb;
    }

    .preview-image {
        margin-top: 1rem;
        max-width: 200px;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    .character-count {
        font-size: 0.875rem;
        color: #888;
        text-align: right;
        margin-top: 0.3rem;
    }

    .character-count.warning {
        color: #eab308;
    }

    .character-count.danger {
        color: #dc2626;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .order-container {
            padding-left: 1rem; /* remove sidebar offset */
            padding-right: 1rem;
        }
    }
</style> 



<div class="order-container">
    <div class="order-card">
        <div class="order-header">
            <h1><i class="bi bi-plus-circle-fill me-2"></i>Create Garment Order</h1>
            <p>Provide your details below to place your custom garment order</p>
        </div>

        <div class="order-body">
            <form asp-action="CreateOrder" method="post" enctype="multipart/form-data">
                <div class="section-title"><i class="bi bi-tags-fill"></i> Garment Details</div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="GarmentType" class="form-label">Garment Type</label>
                        <input asp-for="GarmentType" class="form-control" placeholder="T-Shirt, Dress, etc." required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Quantity" class="form-label">Quantity</label>
                        <input asp-for="Quantity" type="number" min="1" class="form-control" required />
                    </div>
                </div>

                <div class="section-title"><i class="bi bi-calendar-event-fill"></i> Delivery & Instructions</div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="DeliveryDate" class="form-label">Expected Delivery Date</label>
                        <input asp-for="DeliveryDate" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CustomerInstructions" class="form-label">Customer Instructions</label>
                        <textarea asp-for="CustomerInstructions" class="form-control" rows="3" maxlength="500" placeholder="Mention special requirements..."></textarea>
                        <div class="character-count" id="instructionsCount">0/500 characters</div>
                    </div>
                </div>

                <div class="section-title"><i class="bi bi-image-fill"></i> Reference Image</div>
                <div class="file-upload-area" id="uploadArea">
                    <i class="bi bi-cloud-arrow-up upload-icon"></i>
                    <p class="mt-2 mb-2 text-muted">Click or drag & drop to upload</p>
                    <input type="file" name="ImageUpload" id="imageUpload" class="d-none" accept="image/*" />
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.getElementById('imageUpload').click()">Choose File</button>
                    <div class="mt-2 text-danger small" id="imageError"></div>
                    <div id="imagePreview" class="mt-3" style="display:none;">
                        <img id="previewImage" class="preview-image" />
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn-submit">
                        <i class="bi bi-send-check-fill me-1"></i> Submit Order
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const fileInput = document.getElementById('imageUpload');
        const imagePreview = document.getElementById('imagePreview');
        const previewImage = document.getElementById('previewImage');
        const imageError = document.getElementById('imageError');

        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                const file = e.target.files[0];
                if (!file.type.startsWith('image/')) {
                    imageError.textContent = 'Please select a valid image.';
                    return;
                }
                if (file.size > 5 * 1024 * 1024) {
                    imageError.textContent = 'File size must be under 5MB.';
                    return;
                }
                imageError.textContent = '';
                const reader = new FileReader();
                reader.onload = function (ev) {
                    previewImage.src = ev.target.result;
                    imagePreview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });

        const instructionsTextarea = document.querySelector('textarea[name="CustomerInstructions"]');
        const instructionsCount = document.getElementById('instructionsCount');

        instructionsTextarea.addEventListener('input', function () {
            const len = this.value.length;
            instructionsCount.textContent = `${len}/500 characters`;
            instructionsCount.classList.toggle('warning', len > 400 && len <= 480);
            instructionsCount.classList.toggle('danger', len > 480);
        });
    </script>
}
