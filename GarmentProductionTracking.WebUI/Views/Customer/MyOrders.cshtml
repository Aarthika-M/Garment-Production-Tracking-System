@model IEnumerable<Application.DTOs.CustomerOrderDTO>
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "My Orders";
    var statuses = new List<string> { "Processing", "Completed", "Pending" };
    var random = new Random();
}
<style>
    /* ===== Root Colors ===== */
    :root {
        --primary: #2c3e50;
        --secondary: #3498db;
        --accent: #e74c3c;
        --success: #2ecc71;
        --warning: #f39c12;
        --danger: #e74c3c;
        --light: #ecf0f1;
        --dark: #2c3e50;
        --gray: #95a5a6;
        --transition: all 0.3s ease;
    }

    body {
        font-family:  'Poppins', sans-serif;
        background-color: #f8f9fa;
        color: #333;
    }

    /* Page Header */
    .page-header {
        border-bottom: 1px solid #eaeaea;
        padding-bottom: 15px;
        margin-bottom: 25px;
        background: #B13BFF;
        
        
    }
    
    .page-title {
        font-weight: 300;
        color: white;
        position: relative;
        padding-left: 12px;
        
    }
    .page-title::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 5px;
        height: 70%;
        background-color: var(--secondary);
        border-radius: 3px;
    }
    .header-hover h1,
.header-hover h1 i,
.header-hover p {
    color: white; /* default color */
    transition: color 0.3s ease; /* smooth transition */
}

.header-hover:hover h1,
.header-hover:hover h1 i,
.header-hover:hover p {
    color: #FA812F; /* color on hover */
    cursor: pointer; /* optional, shows pointer on hover */
}

    /* Filter Section */
    .filter-section {
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

    /* Order Card */
    .order-card {
        transition: var(--transition);
        overflow: hidden;
        background-color: #fff;
        display: flex;
        flex-direction: column;
        height: 100%;
        border-radius: 15px;
    }
    .order-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    /* Status Badges */
    .status-badge {
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 20px;
        padding: 5px 12px;
    }
    .pending { background-color: #fff3cd; color: #856404; }
    .processing { background-color: #cce7ff; color: #004085; }
    .completed { background-color: #d4edda; color: #155724; }


.order-image-preview {
    max-width: 120px;   /* adjust width as needed */
    max-height: 120px;  /* adjust height as needed */
    object-fit: cover;  /* keeps proportions, crops if needed */
    border-radius: 6px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}
.form-select {
    border: 2px solid #ced4da;  /* default light gray border */
    border-radius: 6px;
    padding: 0.5rem 1rem;
    transition: all 0.3s ease;
    background-color: #fff;
    color: #2c3e50;
}

.form-select:hover {
    border-color: #6a11cb       /* violet border on hover */
    box-shadow:  0 0 0 3px rgba(106, 17, 203, 0.15); /* optional soft glow */
}

.form-select:focus {
    outline: none;
    border-color: #6a11cb;       /* violet border on focus */
    box-shadow:  0 0 0 3px rgba(106, 17, 203, 0.15); /* stronger glow on focus */
}


        
    /* Buttons */
    .btn-primary {
        background-color: var(--secondary);
        border-color: var(--secondary);
        transition: var(--transition);
    }
    .btn-primary:hover {
        background-color: #2980b9;
        border-color:white ;
    }

    .btn-outline-primary {
        border-radius: 8px;
    }
    .btn-custom {
    background-color:  #450693;      /* normal background */
    color: white;               /* text color */
    border: 2px solid white;    /* optional border */
    transition: all 0.3s ease;    /* smooth hover transition */
}

.btn-custom:hover {
    background: #9929EA;     
    color: #FA812F;                 /* hover text color */
             
}
    
    /* Responsive */
    @@media(max-width:768px) {
        .order-card { margin-bottom: 20px; }
    }
</style>


<div class="container-fluid mt-3">
    <!-- Page Header -->
    <div class="page-header d-flex align-items-center justify-content-between mb-4">
        <div class="header-hover">
    <h1><i class="bi bi-card-list"></i> My Orders</h1>
    <p class="large mb-0">Manage your custom garment orders</p>
</div>
        <a asp-controller="Customer" asp-action="CreateOrder" class="btn btn-custom btn-lg shadow-sm">
            <i class="fas fa-plus me-2"></i> New Order
        </a>
    </div>

    <!-- Filter Section -->
    <div class="filter-section p-3 mb-4 bg-white rounded shadow-sm">
    <div class="row align-items-end g-3">
        <!-- Column 1: Order Status -->
        <div class="col-md-4">
            <label class="form-label fw-semibold small text-muted">Order Status</label>
            <select class="form-select" id="statusFilter">
                <option value="all" selected>All Orders</option>
                <option value="pending">Pending</option>
                <option value="processing">Processing</option>
                <option value="completed">Completed</option>
            </select>
        </div>

        <!-- Column 2: Order Date -->
        <div class="col-md-4">
            <label class="form-label fw-semibold small text-muted">Order Date</label>
            <select class="form-select" id="dateFilter">
                <option value="all" selected>All Time</option>
                <option value="week">Past Week</option>
                <option value="month">Past Month</option>
                <option value="quarter">Past 3 Months</option>
            </select>
        </div>

        <!-- Column 3: Garment Type -->
        <div class="col-md-4">
            <label class="form-label fw-semibold small text-muted">Garment Type</label>
            <select class="form-select" id="garmentFilter">
                <option value="all" selected>All Types</option>
                <option value="shirt">Shirts</option>
                <option value="pants">Pants</option>
                <option value="dress">Dresses</option>
                <option value="suit">Suits</option>
            </select>
        </div>
    </div>
</div>


    <!-- Orders Grid -->
    <div class="row g-4" id="ordersContainer">
        @if (Model.Any())
        {
            @foreach (var order in Model)
            {
                var orderStatus = statuses[random.Next(statuses.Count)];
                <div class="col-12 col-md-6 col-lg-4 order-item" data-status="@orderStatus.ToLower()">
                    <div class="card order-card shadow-hover border-0 rounded-4 overflow-hidden h-100">
                        <div class="card-body d-flex flex-column p-3">
                            <!-- Order Header -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-dark">Order @order.Id</span>
                                <span class="text-muted small"><i class="far fa-calendar-alt me-1"></i> @order.OrderDate.ToShortDateString()</span>
                            </div>

                            <!-- Garment Info -->
                            <h5 class="card-title fw-bold text-dark mb-2">@order.GarmentType</h5>
                            <ul class="list-unstyled mb-3 detail-list">
                                <li><i class="fas fa-layer-group me-2 text-primary"></i> Quantity: <span class="fw-bold text-primary">@order.Quantity</span></li>
                                <li><i class="fas fa-truck me-2 text-success"></i> Delivery: @order.DeliveryDate.ToShortDateString()</li>
                                <li class="text-truncate"><i class="fas fa-comment-alt me-2 text-secondary"></i> Instruction: @order.CustomerInstructions</li>
                            </ul>

                            <!-- Image -->
                            <div class="text-center mb-3 mt-auto">
                                @if (order.ImageContent != null && order.ImageContent.Length > 0)
                                {
                                    <img src="data:image/png;base64,@Convert.ToBase64String(order.ImageContent)"
                                         alt="Garment Image"
                                         class="img-fluid rounded-3 order-image-preview" />
                                }
                                else
                                {
                                    <div class="no-image-placeholder py-3">
                                        <i class="fas fa-camera fa-2x text-muted"></i>
                                        <p class="small text-muted mt-2 mb-0">Design Sketch</p>
                                    </div>
                                }
                            </div>

                          
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info text-center rounded-3 shadow-sm p-5">
                    <i class="fas fa-box-open mb-3" style="font-size: 2.5rem;"></i>
                    <h4 class="fw-bold">No Orders Found</h4>
                    <p class="text-muted">You haven't placed any orders yet.</p>
                </div>
            </div>
        }
    </div>
</div>

